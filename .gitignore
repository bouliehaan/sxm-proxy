# Credentials never get committed. The password lives in this file and is
# mounted as a Docker secret, not passed as an environment variable, so it
# does not show up in `docker inspect` or the process table.
sxm_password.txt
.env

# The upstream checkout is cloned, not vendored.
sxm-player/

# Generated by upstream's M3U exporter, which we keep disabled. They bake in
# whichever hostname produced them, so they are machine-specific noise rather
# than anything worth tracking. deploy.sh already leaves them out of the bundle.
playlists/
